# Gemini (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=
# Gemini 모델 (기본: 항상 최신 Flash를 가리키는 별칭)
GEMINI_MODEL=gemini-flash-latest

# (선택) Gemini가 실패하면 Claude로 대신 읽기 — https://platform.claude.com 에서 API 키 발급
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Supabase 프로젝트 > Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 이메일 (쉼표로 여러 명)
ADMIN_EMAILS=
